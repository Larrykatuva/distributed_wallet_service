# ── Servers ───────────────────────────────────────────────────────────────────
PORT=3003
GRPC_PORT=3004
# Comma-separated list. Wildcards allowed, e.g. https://*.example.com
CORS_ALLOWED_ORIGINS=http://localhost:*
SHUTDOWN_TIMEOUT=15s

# ── Logging ───────────────────────────────────────────────────────────────────
# Logs always go to stdout. LOG_TO_FILE=true (default) also writes one file per day: ./logs/<YYYY-MM-DD>-app.log
LOG_TO_FILE=true
LOG_DIR=./logs

# ── Transaction recovery ──────────────────────────────────────────────────────
TRANSACTION_TIMEOUT=30s         # per-stage wait for wallet replies before failing the leg
RECOVERY_STALE_AFTER=2m         # incomplete + unchanged for this long → re-driven by the sweeper
RECOVERY_SWEEP_INTERVAL=30s
RECOVERY_MAX_ATTEMPTS=5         # then marked failed (reconciliation flagged if money moved)

# ── Actor cluster ─────────────────────────────────────────────────────────────
CLUSTER_MODE=single        # single | cluster
CLUSTER_NAME=wallet-cluster
CLUSTER_PORT=8090
ADVERTISED_HOST=127.0.0.1
AUTOMANAGED_PORT=6330      # single mode discovery port; change to run two instances locally

# ── Kubernetes (only used when CLUSTER_MODE=cluster) ──────────────────────────
K8S_NAMESPACE=default

# ── Connection pooler (PgBouncer) ────────────────────────────────────────────
# false: connect to Postgres directly. true: application pool goes through
# PgBouncer; migrations always go direct. Flip to true under heavy traffic.
USE_PGBOUNCER=false
PGBOUNCER_HOST=127.0.0.1
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction   # transaction | session (match pgbouncer.ini)

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
# Leave REDIS_ADDR empty to run without a cache.
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=5m

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=wallet_database
DB_SSLMODE=disable
